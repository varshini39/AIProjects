# --------------------------------------------------------------------
# FinEdge Mumbai — AutoGen-style LinkedIn Microservice
# Copy this file to `.env` and fill in real values before running.
# --------------------------------------------------------------------

# Set to "true" to use the offline deterministic mock agents (no API
# key required — recommended for grading, curl testing, and n8n
# "Execute Node" runs). Set to "false" to route through real AG2/AutoGen
# agents backed by an OpenAI-compatible model.
USE_MOCK=true

# Required only when USE_MOCK=false
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini

# Default minimum confidence score (0-1) the Approval Gate in n8n will
# also enforce; kept here so the microservice's own default matches.
MIN_CONFIDENCE=0.75

# Where run logs (JSON Lines) are appended for traceability.
LOG_FILE=runs.log.jsonl

# Port the FastAPI/uvicorn server binds to.
PORT=8000
